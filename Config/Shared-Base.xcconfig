// Shared-Base.xcconfig
// Version numbers shared across all targets (iOS + macOS)

// ==========================================
// Versioning
// ==========================================
// CtrlX changes the application, storage, E2EE and Relay identity. It is a new
// major distribution and deliberately does not interoperate with Gallager 2.x.
MARKETING_VERSION = 3.0.32
CURRENT_PROJECT_VERSION = 1

// Local/release packaging scripts override these with a UTC timestamp and the
// source commit. They are display-only and must not affect protocol versioning.
CTRLX_BUILD_STAMP =
CTRLX_SOURCE_REVISION =

// ==========================================
// Build Performance
// ==========================================
// Cache compilation results across builds (branch switching, clean builds)
COMPILATION_CACHE_ENABLE_CACHING = YES
// Allow linker to start before all compilation finishes
EAGER_LINKING = YES
