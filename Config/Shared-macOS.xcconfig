// Shared-macOS.xcconfig
// Shared configuration for macOS targets

#include "Shared-Base.xcconfig"

// ==========================================
// Platform Configuration
// ==========================================
SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0

// ==========================================
// Product Identity
// ==========================================
PRODUCT_NAME = CtrlX

// A distribution must supply its own Sparkle EdDSA public key in
// Local-macOS.xcconfig. It verifies the Qcloud installer script; an empty value
// keeps in-app updates safely disabled.
CTRLX_SPARKLE_PUBLIC_KEY =
