<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CtrlXBuildStamp</key>
	<string>$(CTRLX_BUILD_STAMP)</string>
	<key>CtrlXSourceRevision</key>
	<string>$(CTRLX_SOURCE_REVISION)</string>
	<!-- Apple Events Usage Description - required for AppleScript automation -->
	<key>NSAppleEventsUsageDescription</key>
	<string>CtrlX needs to control terminal applications to open tmux sessions.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>CtrlX uses Bluetooth for passkey sign-in with nearby devices in its browser.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>CtrlX uses the microphone to turn your speech into terminal input.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>CtrlX recognizes your speech on this Mac to compose terminal input.</string>

	<!-- Verifies the signed macOS installer script (mac.sh.sig). -->
	<key>SUPublicEDKey</key>
	<string>$(CTRLX_SPARKLE_PUBLIC_KEY)</string>

	<!-- Custom drag types must be registered for native drop destinations. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.jicezeng.ctrlx.workbench-tab</string>
			<key>UTTypeDescription</key>
			<string>CtrlX Workbench Tab</string>
			<key>UTTypeConformsTo</key>
			<array><string>public.data</string></array>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.jicezeng.ctrlx.tab-drag</string>
			<key>UTTypeDescription</key>
			<string>CtrlX Tab Drag</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.jicezeng.ctrlx.quick-phrase</string>
			<key>UTTypeDescription</key>
			<string>CtrlX Quick Phrase Drag</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
	</array>
</dict>
</plist>
