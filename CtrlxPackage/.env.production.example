# Set these two values to the exact tag build before every deployment.
CTRLX_VERSION=3.0.0
CTRLX_SOURCE_REVISION=REPLACE_WITH_FULL_GIT_COMMIT
CTRLX_SOURCE_REPOSITORY=https://github.com/jicezeng/CtrlX
CTRLX_PROTOCOL_VERSION=3.0
CTRLX_COMPOSE_PROJECT_NAME=ctrlx
CTRLX_RELAY_BIND_ADDRESS=0.0.0.0
CTRLX_RELAY_HOST_ADDRESS=127.0.0.1
CTRLX_RELAY_PORT=8080
LOG_LEVEL=warning
PAIRING_CODE_EXPIRY_SECONDS=300
DATA_DIRECTORY=/data
# open (default), or metered for account keys and monthly traffic quotas.
# Metered mode requires persistent DATA_DIRECTORY and disables legacy licensing.
RELAY_ACCESS_MODE=open
# Exact socket peer IPs of trusted proxies, comma-separated; empty trusts none.
# With Docker, use the proxy/gateway IP seen inside the Relay container.
RELAY_TRUSTED_PROXY_IPS=
METRICS_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MIN_CLIENT_VERSION=3.0.0
MIN_CLIENT_VERSION_REJECT_UNKNOWN=true
PAIRING_PAUSED_MESSAGE=

# APNs is optional. Leave all credential values empty to disable push.
APNS_KEY_PATH=/secrets/AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.jicezeng.ctrlx
APNS_ENVIRONMENT=production

# Licensing remains disabled in the CtrlX community distribution.
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRODUCT_ID=
