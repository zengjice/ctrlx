// Shared.xcconfig
// Shared configuration for iOS targets
// All other settings use Xcode project defaults

#include "Shared-Base.xcconfig"

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = CtrlX
PRODUCT_DISPLAY_NAME = CtrlX
CTRLX_IOS_DEVELOPMENT_TEAM =
CTRLX_IOS_APP_BUNDLE_IDENTIFIER = com.jicezeng.ctrlx
CTRLX_IOS_NOTIFICATION_EXTENSION_BUNDLE_IDENTIFIER = com.jicezeng.ctrlx.notification-service
PRODUCT_BUNDLE_IDENTIFIER = $(CTRLX_IOS_APP_BUNDLE_IDENTIFIER)

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 18.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_NSCameraUsageDescription = CtrlX uses the camera only to send a photo you take to the selected terminal.

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/Ctrlx.entitlements to add capabilities
CTRLX_IOS_APP_ENTITLEMENTS = Config/Ctrlx.entitlements
CTRLX_IOS_NOTIFICATION_EXTENSION_ENTITLEMENTS = CtrlxNotificationExtension/CtrlxNotificationExtension.entitlements
CODE_SIGN_ENTITLEMENTS = $(CTRLX_IOS_APP_ENTITLEMENTS)

// ==========================================
// Embedded Frameworks
// ==========================================
// Required for embedded frameworks to be found at runtime
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
